{
  "name": "TFA Midnight Ledger",
  "dataColors": [
    "#3D5A80",
    "#E09F3E",
    "#14213D",
    "#2A9D8F",
    "#98C1D9",
    "#C8553D",
    "#8D99AE",
    "#F2CC8F"
  ],
  "foreground": "#14213D",
  "foregroundNeutralSecondary": "#5A6478",
  "foregroundNeutralTertiary": "#8D99AE",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6F9",
  "backgroundNeutral": "#DCE1EA",
  "tableAccent": "#3D5A80",
  "good": "#2A9D8F",
  "neutral": "#E09F3E",
  "bad": "#C8553D",
  "maximum": "#14213D",
  "center": "#98C1D9",
  "minimum": "#EEF1F5",
  "hyperlink": "#3D5A80",
  "visitedHyperlink": "#14213D",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#14213D"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#14213D"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#14213D"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5A6478"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 6,
            "bottom": 6,
            "left": 10,
            "right": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#14213D"
              }
            },
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#5A6478"
              }
            }
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#5A6478"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "gridlineStyle": "solid",
            "labelColor": {
              "solid": {
                "color": "#5A6478"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "position": "TopLeft",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5A6478"
              }
            }
          }
        ],
        "labels": [
          {
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#14213D"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#14213D"
              }
            },
            "fontSize": 10
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#C9D3E3"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#5A6478"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#14213D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorAlternate": {
              "solid": {
                "color": "#F7F9FB"
              }
            },
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "gridVertical": false
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#5A6478"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#14213D"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#14213D"
              }
            },
            "fontSize": 10
          }
        ],
        "subTotals": [
          {
            "fontFamily": "Segoe UI Semibold",
            "backColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "gridVertical": false
          }
        ]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [
          {
            "increaseFill": {
              "solid": {
                "color": "#2A9D8F"
              }
            },
            "decreaseFill": {
              "solid": {
                "color": "#C8553D"
              }
            },
            "totalFill": {
              "solid": {
                "color": "#14213D"
              }
            }
          }
        ]
      }
    }
  }
}