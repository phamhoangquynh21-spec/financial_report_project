	/// Actual value of the scorecard metric in dim_metric
	measure 'Scorecard Actual' = SWITCH ( SELECTEDVALUE ( dim_metric[Order] ), 1, [Gross Profit Margin %], 2, [Opex Ratio %], 3, [EBIT Margin %], 4, [Net Profit Margin %] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 09 Benchmark
		lineageTag: 552c9fd2-7cf2-4d70-afc8-59271269592b

	/// Industry benchmark of the scorecard metric
	measure 'Scorecard Industry' = SWITCH ( SELECTEDVALUE ( dim_metric[Order] ), 1, [Benchmark Gross Margin], 2, [Benchmark Opex Ratio], 3, [Benchmark EBIT Margin], 4, [Benchmark Net Margin] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 09 Benchmark
		lineageTag: 0d9802b6-afa1-46b6-922a-e8d6255c6fea

	/// Actual minus industry, in percentage points
	measure 'Scorecard Gap' =
			VAR _a = [Scorecard Actual]
			VAR _b = [Scorecard Industry]
			RETURN IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), ( _a - _b ) * 100 )
		formatString: 0.00
		displayFolder: 09 Benchmark
		lineageTag: c84f0f76-6298-4ae4-8ac3-b12dee36c876

	/// Teal when the line beats industry (lower is better for Opex ratio)
	measure 'Scorecard Gap Color' =
			VAR _g = [Scorecard Gap]
			VAR _lowerBetter = SELECTEDVALUE ( dim_metric[Order] ) = 2
			RETURN IF ( ISBLANK ( _g ), "#5A6478", IF ( ( _g >= 0 && NOT _lowerBetter ) || ( _g <= 0 && _lowerBetter ), "#2A9D8F", "#C8553D" ) )
		displayFolder: 09 Benchmark
		lineageTag: 6b42af3d-5c6f-427e-9664-b005e52a9ab6

	/// Compound monthly growth rate Jan to Dec FY2023 (linear fallback when Jan or Dec is not positive), plus count of months that rose vs the prior month. Ignores the Month slicer.
	measure 'Revenue FY Trend Label' =
			VAR _f = CALCULATE ( [Total Revenue], REMOVEFILTERS ( dim_calendar ), dim_calendar[Month] = 1 )
			VAR _l = CALCULATE ( [Total Revenue], REMOVEFILTERS ( dim_calendar ), dim_calendar[Month] = 12 )
			VAR _rate = IF ( _f > 0 && _l > 0, POWER ( DIVIDE ( _l, _f ), 1 / 11 ) - 1, DIVIDE ( _l - _f, ABS ( _f ) ) / 11 )
			VAR _ups = CALCULATE ( COUNTROWS ( FILTER ( VALUES ( dim_calendar[Month] ), [Revenue MoM %] > 0 ) ), REMOVEFILTERS ( dim_calendar ) )
			RETURN
			    IF ( ISBLANK ( _f ) || ISBLANK ( _l ), BLANK (),
			        "Jan→Dec " & IF ( _rate >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _rate ), "0.0%" ) & "/mo · " & COALESCE ( _ups, 0 ) & "/11 up" )
		displayFolder: 04 Time
		lineageTag: 5d327f2b-070b-4a60-a9ac-432e4c062eae

	/// Grey when the FY2023 Revenue Jan-to-Dec trend moves less than 0.5%/mo; otherwise green when favourable (rising), red when not
	measure 'Revenue FY Trend Color' =
			VAR _f = CALCULATE ( [Total Revenue], REMOVEFILTERS ( dim_calendar ), dim_calendar[Month] = 1 )
			VAR _l = CALCULATE ( [Total Revenue], REMOVEFILTERS ( dim_calendar ), dim_calendar[Month] = 12 )
			VAR _rate = IF ( _f > 0 && _l > 0, POWER ( DIVIDE ( _l, _f ), 1 / 11 ) - 1, DIVIDE ( _l - _f, ABS ( _f ) ) / 11 )
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _f ) || ISBLANK ( _l ), "#5A6478",
			        ABS ( _rate ) < 0.005, "#5A6478",
			        _rate >= 0, "#2A9D8F", "#C8553D" )
		displayFolder: 08 Display
		lineageTag: 77ba9305-e007-48c8-a54d-e9854ec5a23a

