			        "Jan→Dec " & IF ( _rate >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _rate ) * 100, "0.00" ) & " pp/mo · " & COALESCE ( _ups, 0 ) & "/11 up" )
