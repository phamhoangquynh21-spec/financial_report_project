table dim_subgroup
	lineageTag: 90e9f301-f7c7-4cee-b218-e68cde32b346

	column Subgroup
		dataType: string
		lineageTag: cba5021b-a300-489a-bed6-0bd523c9f470
		summarizeBy: none
		sourceColumn: Subgroup

		annotation SummarizationSetBy = Automatic

	column 'Subgroup ID'
		dataType: int64
		formatString: 0
		lineageTag: bf6e297c-b9f6-4fcd-a0e7-bc81d943bc67
		summarizeBy: none
		sourceColumn: Subgroup ID

		annotation SummarizationSetBy = Automatic

	column 'Group ID'
		dataType: int64
		formatString: 0
		lineageTag: 80cc9fdd-b11c-47a0-9b5f-344a028b7eeb
		summarizeBy: none
		sourceColumn: Group ID

		annotation SummarizationSetBy = Automatic

	partition dim_subgroup = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Users\User\Documents\Financial Data\Subgroup.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"Subgroup", type text}, {"Subgroup ID", Int64.Type}, {"Group ID", Int64.Type}}, "en-US"),
				  // Rename shared 'Other' (ID 9) to Other Opex and add ID 16 Other COGS (Group 3)
				  #"Relabel Other" = Table.ReplaceValue(#"Changed column type", each [Subgroup], each if [Subgroup ID] = 9 then "Other Opex" else [Subgroup], Replacer.ReplaceValue, {"Subgroup"}),
				  #"Added Other COGS" = Table.Combine({#"Relabel Other", #table(type table [Subgroup = text, #"Subgroup ID" = Int64.Type, #"Group ID" = Int64.Type], {{"Other COGS", 16, 3}})})
				in
				  #"Added Other COGS"

	annotation PBI_ResultType = Table

